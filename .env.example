# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=studyflow
POSTGRES_DB=studyflow
POSTGRES_PORT=5432

# --- Backend (read by backend/app/config.py) ---
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first, and the container
# only listens on IPv4 127.0.0.1, so the connection would stall before falling back.
DATABASE_URL=postgresql+psycopg://studyflow:studyflow@127.0.0.1:5432/studyflow
# Used by pytest only. The test suite drops and recreates every table in this database.
TEST_DATABASE_URL=postgresql+psycopg://studyflow:studyflow@127.0.0.1:5432/studyflow_test

# At least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-before-deploying
# The app silently swaps its refresh cookie for a new access token when this runs out.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a login lasts without being used.
REFRESH_TOKEN_EXPIRE_DAYS=30

# One-click "Explore the demo" on the login page (POST /api/auth/demo). Off by default.
DEMO_ENABLED=false

# Email, for password reset and confirming a new address: none (features hidden), console
# (prints emails here, handy in development), file (writes .eml files to MAIL_OUTBOX_DIR) or smtp.
MAIL_BACKEND=console
# For smtp (any provider: Resend, Brevo, Gmail with an app password, ...):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# MAIL_FROM=StudyFlow <no-reply@your-domain.example>
# PUBLIC_URL=https://studyflow-q3u0.onrender.com

# JSON list of origins allowed to call the API from a browser (Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]
