{
  "name": "studyflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.ts --default-non-nullable false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
